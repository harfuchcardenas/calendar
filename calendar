#!/usr/bin/perl
use strict;
use warnings;
use POSIX qw(strftime);
use Time::Local qw(timegm);

my ($today, $cur_mon, $cur_year) = (localtime)[3, 4, 5];
$cur_year += 1900;
my ($mon, $year) = ($cur_mon, $cur_year);

my $view = 'month';                                  # 'month' or 'day'
my $sel  = timegm(0, 0, 12, $today, $cur_mon, $cur_year);   # selected day (noon UTC)

sub days_in_month {
    my ($m, $y) = @_;
    my @dim = (31,28,31,30,31,30,31,31,30,31,30,31);
    $dim[1] = 29 if ($y % 4 == 0 && $y % 100 != 0) || $y % 400 == 0;
    return $dim[$m];
}

sub draw_month {
    my ($m, $y) = @_;
    my $days  = days_in_month($m, $y);
    my $wday  = (gmtime timegm(0, 0, 12, 1, $m, $y))[6];   # 0 = Sunday
    my $title = strftime("%B %Y", 0, 0, 0, 1, $m, $y - 1900);

    print "\e[H\e[2J";                                      # clear screen
    printf "%s%s\n", " " x int((20 - length $title) / 2), $title;
    print "Su Mo Tu We Th Fr Sa\n";
    print "   " x $wday;

    for my $d (1 .. $days) {
        my $is_today = ($d == $today && $m == $cur_mon && $y == $cur_year);
        print $is_today ? sprintf("\e[7m%2d\e[0m", $d) : sprintf("%2d", $d);
        print +(($wday + $d) % 7 == 0) ? "\n" : " ";
    }
    print "\n" if ($wday + $days) % 7 != 0;
    print "\n<- previous   next ->\nt: today   d: day view   q: quit\n";
}

sub draw_day {
    my ($d, $m, $y) = (gmtime $sel)[3, 4, 5];
    my $text = strftime("%A %d.%b.%Y", 0, 0, 12, $d, $m, $y);   # Wednesday 25.Nov.2026

    print "\e[H\e[2J";
    print "$text\n";
    print "\n<- previous day   next day ->\nt: today   m: month view   q: quit\n";
}

sub redraw {
    if ($view eq 'day') { draw_day() } else { draw_month($mon, $year) }
}

# Put the terminal in raw-ish mode (no echo, no line buffering)
system("stty -echo -icanon min 1 time 0");
END { system("stty echo icanon") if -t STDIN; }
$SIG{INT} = $SIG{TERM} = sub { exit 0 };

# Read one byte, optionally waiting at most $timeout seconds
sub read_byte {
    my ($timeout) = @_;
    if (defined $timeout) {
        my $rin = '';
        vec($rin, fileno(STDIN), 1) = 1;
        return undef unless select($rin, undef, undef, $timeout);
    }
    my $n = sysread(STDIN, my $c, 1);
    return $n ? $c : undef;
}

redraw();

while (defined(my $key = read_byte())) {
    if ($key eq "\e") {
        my $b1 = read_byte(0.05);
        last unless defined $b1;          # lone Esc quits
        my $b2 = read_byte(0.05);
        next unless defined $b2 && $b1 eq '[';

        my $dir = $b2 eq 'C' ? 1 : $b2 eq 'D' ? -1 : 0;   # right = +1, left = -1
        next unless $dir;

        if ($view eq 'month') {
            $mon += $dir;
            if    ($mon > 11) { $mon = 0;  $year++; }
            elsif ($mon < 0)  { $mon = 11; $year--; }
        } else {
            $sel += $dir * 86400;         # step one day (noon UTC avoids DST issues)
        }
        redraw();
    }
    elsif ($key eq 't' || $key eq 'T') {
        # Jump to the current date, staying in the current view
        $sel = timegm(0, 0, 12, $today, $cur_mon, $cur_year);
        ($mon, $year) = ($cur_mon, $cur_year);
        redraw();
    }
    elsif ($key eq 'd' || $key eq 'D') {
        $view = 'day';
        $sel  = timegm(0, 0, 12, $today, $cur_mon, $cur_year);   # jump to today
        redraw();
    }
    elsif ($key eq 'm' || $key eq 'M') {
        $view = 'month';
        ($mon, $year) = (gmtime $sel)[4, 5];     # show the month of the selected day
        $year += 1900;
        redraw();
    }
    elsif ($key eq 'q' || $key eq 'Q') {
        last;
    }
}

print "\n";
